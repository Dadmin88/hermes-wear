<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <application android:allowBackup="false" android:label="Hermes Bridge" android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".PhoneListenerService" android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/>
        <data android:scheme="wear" android:host="*" android:pathPrefix="/hermes-wear/"/>
      </intent-filter>
    </service>
  </application>
</manifest>
